# Every build (D-025). ESP32-S3-WROOM-1-N16R8: 16 MB quad flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# the PSRAM memory test adds ~2 s to every boot (HARDWARE_LESSONS)
CONFIG_SPIRAM_MEMTEST=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_BOARD_TARGET_REAL=y
# capture-clip (D-025 Phase D.3)
# The flash and PSRAM need 2.7 V: reset before writes go out of spec (research/2026-09-29-esp32-firmware.md §7)
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# TLS buffers in PSRAM, one session at a time
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_FREERTOS_HZ=1000
