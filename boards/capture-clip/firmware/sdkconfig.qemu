# Espressif QEMU (D-025): no USB, so the console is UART0; the target switch turns on the
# stand-ins (tests that need GPIO, I2C, I2S or Wi-Fi report "skip").
CONFIG_BOARD_TARGET_QEMU=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# QEMU has no RTC watchdog on the S3 (HARDWARE_LESSONS)
CONFIG_BOOTLOADER_WDT_ENABLE=n
# capture-clip: QEMU's OpenCores Ethernet stands in for Wi-Fi; it talks only to the mock server
CONFIG_ETH_USE_OPENETH=y
